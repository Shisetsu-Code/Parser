{
  "name": "game-control-parser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Playwright parser for discovering and pressing runtime game controls without vision.",
  "scripts": {
    "start": "node src/index.js",
    "check": "node --check src/index.js && node --check src/runner.js && node --check src/tree-crawler.js && node --check src/providers/threeoaks.js && node --check src/providers/pragmatic.js && node --check src/providers/generic-canvas.js && node --check src/providers/belatra.js",
    "start:pause": "node src/index.js --pause-after-purchase",
    "start:hold15": "node src/index.js --hold-after-purchase 15000",
    "live:smoke": "node scripts/live-smoke.mjs",
    "belatra:sequential": "node scripts/belatra-sequential-smoke.mjs",
    "pragmatic:audit20": "node scripts/pragmatic-purchase-audit.mjs",
    "pragmatic:audit-more20": "node scripts/pragmatic-purchase-audit-more20.mjs",
    "pragmatic:feature-audit": "node scripts/pragmatic-feature-audit.mjs",
    "pragmatic:spin-diagnostic": "node scripts/pragmatic-spin-diagnostic.mjs",
    "pragmatic:purchase-diagnostic": "node scripts/pragmatic-purchase-runtime-diagnostic.mjs",
    "pragmatic:direct-purchase-spin-test": "node scripts/pragmatic-direct-purchase-spin-test.mjs",
    "pragmatic:protocol-smoke": "node scripts/pragmatic-protocol-continuation-smoke.mjs"
  },
  "dependencies": {
    "playwright": "^1.55.0"
  },
  "engines": {
    "node": ">=20"
  }
}
